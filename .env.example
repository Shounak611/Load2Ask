# Load2Ask Environment Configuration Template & Demos

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Relational Database (Neon PostgreSQL in Production, SQLite/PostgreSQL in Local)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vector Database (Qdrant Cloud in Production, Qdrant Local / In-Memory in Dev)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=https://your-qdrant-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_COLLECTION=load2ask_documents

# AI Provider API Keys
LLM_API_KEY=your_google_gemini_api_key_here
EMBEDDING_API_KEY=your_embedding_api_key_here

# Frontend & CORS Configuration (Vercel Frontend URL)
FRONTEND_URL=https://load2ask.vercel.app
CORS_ORIGINS=https://load2ask.vercel.app,http://localhost:5173

# Storage Abstraction Configuration (Local disk or S3 Object Storage)
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=./uploads
S3_BUCKET_NAME=demo-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# RAG & Context Engineering Tuning Parameters
CHUNK_SIZE=700
CHUNK_OVERLAP=100
MAX_FILE_SIZE_MB=50
RETRIEVAL_TOP_K=25
RERANK_TOP_K=10
CONTEXT_TOKEN_LIMIT=4000
DENSE_WEIGHT=0.6
LEXICAL_WEIGHT=0.4

# Vercel Frontend Environment Variable
VITE_API_URL=https://load2ask-backend.onrender.com
